{
  "private": true,
  "scripts": {
    "build:hero": "esbuild src/hero-entry.jsx --bundle --minify --jsx=automatic --target=es2020 --outfile=assets/hero-dither.js",
    "build:galaxy": "esbuild src/galaxy-entry.tsx --bundle --minify --jsx=automatic --target=es2020 --outfile=assets/galaxy.js && tailwindcss -i src/galaxy-tailwind.css -o assets/galaxy-tailwind.css --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
