    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
